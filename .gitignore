# Regenerable, large, or environment-specific. Everything here is reproducible
# from source + the pinned OSM extract hash recorded in reports/00-network-stats.md.

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.DS_Store

# Downloaded sources — 97 MB PBF + DEM tiles. Provenance (URL + SHA-256) is
# recorded in reports/00-network-stats.md, so these are re-fetchable, not lost.
data/raw/

# Derived geodata — 352 MB, rebuilt deterministically by the pipeline.
data/derived/*.gpkg
data/derived/*.pkl

# Large rendered maps. The .md reports beside them are tracked.
reports/*.html

# Keep the small machine-readable artifacts — these ARE the record of each
# stage's numbers and they are what the reports are asserted against.
!data/derived/*.json
!data/derived/*.csv
